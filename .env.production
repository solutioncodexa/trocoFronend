# Front Troco - production
# Relatif = même domaine que la page (Nginx proxy /api -> backend). Évite ERR_NAME_NOT_RESOLVED
# si www résout mais pas l'apex, ou .ma vs .com.
# Override Docker : docker build --build-arg VITE_API_BASE_URL=https://autre.example/api ...

VITE_API_BASE_URL=/api

