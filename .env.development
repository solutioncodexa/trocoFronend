# Front GoldYara - developpement local
# Utiliser /api pour que le navigateur tape le meme serveur que Vite ; le proxy
# vite.config.ts transmet ensuite vers http://127.0.0.1:8080 (context-path /api).
# Evite les appels directs :8080 (CORS, 307 Chrome "internal redirect").
VITE_API_BASE_URL=/api

# Meta — partage Messenger avec choix de conversation (Send Dialog)
# Créer une app sur https://developers.facebook.com puis ajouter le domaine
# dans « Paramètres > Base > Domaines de l'app » et les redirect_uri produit.
# VITE_FACEBOOK_APP_ID=
